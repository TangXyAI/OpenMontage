{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/asset_manifest",
  "title": "Asset Manifest",
  "description": "Inventory of generated/sourced assets produced by the Asset Generator.",
  "type": "object",
  "required": ["version", "assets"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "source_tool", "scene_id"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["image", "video", "audio", "narration", "music", "sfx", "diagram", "animation", "3d_asset", "3d_world", "code_snippet", "subtitle", "font", "lut"]
          },
          "path": { "type": "string", "description": "Relative path within the pipeline project directory" },
          "source_tool": { "type": "string" },
          "scene_id": { "type": "string" },
          "prompt": { "type": "string", "description": "Generation prompt if AI-generated" },
          "seed": { "type": "integer", "description": "Seed if applicable" },
          "model": { "type": "string", "description": "Model used for generation" },
          "cost_usd": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "resolution": { "type": "string" },
          "format": { "type": "string" },
          "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "subtype": { "type": "string", "description": "Sub-classification (e.g. 'background', 'stock', 'generated')" },
          "generation_summary": { "type": "string", "description": "Brief summary of how the asset was generated or sourced" },
          "provider": { "type": "string", "description": "Provider name (e.g. pixabay, google_imagen)" },
          "license": { "type": "string", "description": "License type (e.g. Pixabay License, CC0)" },
          "original_url": { "type": "string", "description": "Source URL if downloaded from a stock service" },
          "voice_performance": {
            "type": "object",
            "description": "Applied voice-performance contract for narration assets.",
            "properties": {
              "source_section_id": { "type": "string" },
              "delivery_cues_applied": { "type": "boolean" },
              "provider_text_used": { "type": "boolean" },
              "provider_settings": {
                "type": "object",
                "additionalProperties": true
              },
              "sample_approved": { "type": "boolean" },
              "sample_path": { "type": "string" },
              "review_notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "enhancement": {
            "type": "object",
            "required": ["operation", "model", "source_path"],
            "properties": {
              "operation": {"enum": ["face_refine", "video_upscale"]},
              "model": {"type": "string"},
              "source_path": {"type": "string"},
              "parameters": {"type": "object"},
              "workflow_hash_sha256": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "metadata": {
      "type": "object",
      "properties": {
        "refmod_assets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["entity_id", "state", "concept_type", "project_path", "loader_name", "source_path", "source_sha256", "refmod_sha256", "status", "extractor"],
            "properties": {
              "entity_id": {"type": "string", "minLength": 1},
              "state": {"type": "string", "minLength": 1},
              "concept_type": {"type": "string", "enum": ["identity", "clothing", "background", "generic", "style"]},
              "project_path": {"type": "string", "minLength": 1},
              "loader_name": {"type": "string", "pattern": "^openmontage/[^/]+/.+$"},
              "source_path": {"type": "string", "minLength": 1},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "refmod_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "status": {"type": "string", "enum": ["ready", "stale"]},
              "extractor": {
                "type": "object",
                "required": ["tool", "node", "workflow_hash_sha256"],
                "properties": {
                  "tool": {"type": "string", "minLength": 1},
                  "node": {"type": "string", "minLength": 1},
                  "workflow_hash_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "model_stack": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "refmod_usage": {
          "type": "object",
          "required": ["mode", "route_id", "decision_id"],
          "properties": {
            "mode": {"type": "string", "enum": ["project_refmod", "native_ref2va"]},
            "route_id": {"type": "string", "minLength": 1},
            "decision_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "continuity_shots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["scene_id"],
            "properties": {
              "scene_id": { "type": "string", "minLength": 1 },
              "continuity_contract_version": { "type": "string", "const": "1.0" }
            },
            "additionalProperties": false
          }
        },
        "continuity_reviews": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["take_id", "reviewed_path", "dimensions", "notes", "evidence_paths"],
            "properties": {
              "take_id": { "type": "string", "minLength": 1 },
              "reviewed_path": { "type": "string", "minLength": 1 },
              "dimensions": {
                "type": "object",
                "required": ["identity_wardrobe", "location_anchors", "camera_continuity", "light_and_look", "story_state"],
                "properties": {
                  "identity_wardrobe": { "type": "string", "enum": ["pass", "intentional_change", "drift", "unclear"] },
                  "location_anchors": { "type": "string", "enum": ["pass", "intentional_change", "drift", "unclear"] },
                  "camera_continuity": { "type": "string", "enum": ["pass", "intentional_change", "drift", "unclear"] },
                  "light_and_look": { "type": "string", "enum": ["pass", "intentional_change", "drift", "unclear"] },
                  "story_state": { "type": "string", "enum": ["pass", "intentional_change", "drift", "unclear"] }
                },
                "additionalProperties": false
              },
              "notes": {
                "type": "object",
                "required": ["identity_wardrobe", "location_anchors", "camera_continuity", "light_and_look", "story_state"],
                "properties": {
                  "identity_wardrobe": { "type": "string", "minLength": 1 },
                  "location_anchors": { "type": "string", "minLength": 1 },
                  "camera_continuity": { "type": "string", "minLength": 1 },
                  "light_and_look": { "type": "string", "minLength": 1 },
                  "story_state": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "override_reason": { "type": "string", "minLength": 1 }
            },
            "allOf": [{
              "if": {
                "properties": {
                  "dimensions": {
                    "anyOf": [
                      { "properties": { "identity_wardrobe": { "enum": ["drift", "unclear"] } } },
                      { "properties": { "location_anchors": { "enum": ["drift", "unclear"] } } },
                      { "properties": { "camera_continuity": { "enum": ["drift", "unclear"] } } },
                      { "properties": { "light_and_look": { "enum": ["drift", "unclear"] } } },
                      { "properties": { "story_state": { "enum": ["drift", "unclear"] } } }
                    ]
                  }
                },
                "required": ["dimensions"]
              },
              "then": { "required": ["override_reason"] }
            }],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
